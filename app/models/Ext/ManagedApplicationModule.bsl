Процедура ПриНачалеРаботыСистемы()
	Части = СтрРазделить(ПараметрЗапуска, "|");
	Если Части.Количество() <> 3 Или Части[0] <> "waterlab-check" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Итог = ПроверкаРасчетовВызовСервера.ВыполнитьПроверку(Части[1]);
	Исключение
		Итог = "FAIL " + ОписаниеОшибки();
	КонецПопытки;
	ФайлРезультата = Новый ЗаписьТекста(Части[2], КодировкаТекста.UTF8);
	ФайлРезультата.ЗаписатьСтроку(Итог);
	ФайлРезультата.Закрыть();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
