Функция ВыполнитьПроверку(Этап) Экспорт
	Начало = Дата(2026, 10, 1);
	Конец = Дата(2026, 10, 31);

	Если Этап = "baseline" Тогда
		Договор = Справочники.ДоговорыНаОтпускУслуг.СоздатьЭлемент();
		Договор.Наименование = "Учебный договор ДОУ-014";
		Договор.Записать();

		ОбъектРасчетов = Справочники.ОбъектыРасчетов.СоздатьЭлемент();
		ОбъектРасчетов.Наименование = "Учебный объект ОР-104";
		ОбъектРасчетов.Договор = Договор.Ссылка;
		ОбъектРасчетов.Записать();

		Услуга = Справочники.Услуги.СоздатьЭлемент();
		Услуга.Наименование = "Холодное водоснабжение";
		Услуга.Записать();

		Ссылка = РепозиторийРасчетов.Создать(
			ОбъектРасчетов.Ссылка, Услуга.Ссылка, Начало, Конец, 30, 42.5);
		Расчет = РепозиторийРасчетов.Получить(Ссылка);
		Проверить(Расчет.Сумма = 1275, "неверная сумма до обновления");
		Проверить(Расчет.ОбъектРасчетов.Договор = Договор.Ссылка, "договор потерян");
		Возврат "PASS baseline: create + read, amount=1275.00, id="
			+ Строка(Ссылка.УникальныйИдентификатор());
	КонецЕсли;

	Проверить(Этап = "migration", "неизвестный этап проверки");
	ОбъектСсылка = Справочники.ОбъектыРасчетов.НайтиПоНаименованию("Учебный объект ОР-104", Истина);
	Найденные = РепозиторийРасчетов.НайтиЗаПериод(ОбъектСсылка, Начало, Конец);
	Проверить(Найденные.Количество() = 1, "после обновления расчёт не найден");
	Ссылка = Найденные[0].Ссылка;
	Расчет = РепозиторийРасчетов.Получить(Ссылка);
	Проверить(Расчет.Сумма = 1275 И Расчет.Объем = 30 И Расчет.Тариф = 42.5, "меры изменились");
	Проверить(Расчет.ОбъектРасчетов.Договор.Наименование = "Учебный договор ДОУ-014", "договор потерян");
	Проверить(Расчет.Примечание = "", "новое поле должно быть пустым у прежней записи");
	Расчет.Примечание = "Контроль после обновления";
	Расчет.Записать();
	РепозиторийРасчетов.ИзменитьОбъемИТариф(Ссылка, 31, 42.5);
	Расчет = РепозиторийРасчетов.Получить(Ссылка);
	Проверить(Расчет.Сумма = 1317.5 И Расчет.Примечание = "Контроль после обновления",
		"сумма или примечание потерялись при изменении");
	ОшибкаПроверки = Ложь;
	Попытка
		РепозиторийРасчетов.ИзменитьОбъемИТариф(Ссылка, -1, 42.5);
	Исключение
		ОшибкаПроверки = СтрНайти(ОписаниеОшибки(), "Объём должен быть") > 0;
	КонецПопытки;
	Проверить(ОшибкаПроверки И РепозиторийРасчетов.Получить(Ссылка).Сумма = 1317.5, "ошибка проверки объёма");
	РепозиторийРасчетов.ПометитьНаУдаление(Ссылка);
	Проверить(РепозиторийРасчетов.Получить(Ссылка).ПометкаУдаления, "нет пометки удаления");
	Проверить(РепозиторийРасчетов.НайтиЗаПериод(ОбъектСсылка, Начало, Конец).Количество() = 0,
		"помеченный документ попал в выборку");
	Возврат "PASS migration: old data and references preserved, id="
		+ Строка(Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "PASS repository: find, update=1317.50, reject negative volume, mark for deletion";
КонецФункции

Процедура Проверить(Условие, ТекстОшибки)
	Если Не Условие Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
КонецПроцедуры
