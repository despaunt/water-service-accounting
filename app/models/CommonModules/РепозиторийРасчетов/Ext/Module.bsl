Функция Создать(ОбъектРасчетов, Услуга, ПериодНачало, ПериодКонец, Объем, Тариф) Экспорт
	ДокументОбъект = Документы.РасчетОтпускаУслуг.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.ОбъектРасчетов = ОбъектРасчетов;
	ДокументОбъект.Услуга = Услуга;
	ДокументОбъект.ПериодНачало = НачалоДня(ПериодНачало);
	ДокументОбъект.ПериодКонец = НачалоДня(ПериодКонец);
	Если Не ЗначениеЗаполнено(ОбъектРасчетов) Или Не ЗначениеЗаполнено(Услуга) Тогда
		ВызватьИсключение "Укажите объект расчётов и услугу.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодНачало) Или Не ЗначениеЗаполнено(ПериодКонец)
		Или ДокументОбъект.ПериодКонец < ДокументОбъект.ПериодНачало Тогда
		ВызватьИсключение "Проверьте границы периода расчёта.";
	КонецЕсли;
	ЗаписатьСумму(ДокументОбъект, Объем, Тариф);
	Возврат ДокументОбъект.Ссылка;
КонецФункции

Функция Получить(СсылкаРасчета) Экспорт
	Если Не ЗначениеЗаполнено(СсылкаРасчета) Тогда
		ВызватьИсключение "Укажите ссылку на расчёт.";
	КонецЕсли;
	ДокументОбъект = СсылкаРасчета.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		ВызватьИсключение "Расчёт не найден.";
	КонецЕсли;
	Возврат ДокументОбъект;
КонецФункции

Функция НайтиЗаПериод(ОбъектРасчетов, НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Расчеты.Ссылка КАК Ссылка,
	|	Расчеты.Номер КАК Номер,
	|	Расчеты.Сумма КАК Сумма
	|ИЗ
	|	Документ.РасчетОтпускаУслуг КАК Расчеты
	|ГДЕ
	|	Расчеты.ОбъектРасчетов = &ОбъектРасчетов
	|	И Расчеты.ПериодНачало <= &КонецПериода
	|	И Расчеты.ПериодКонец >= &НачалоПериода
	|	И НЕ Расчеты.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Расчеты.Дата, Расчеты.Номер");
	Запрос.УстановитьПараметр("ОбъектРасчетов", ОбъектРасчетов);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(КонецПериода));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ИзменитьОбъемИТариф(СсылкаРасчета, Объем, Тариф) Экспорт
	ДокументОбъект = Получить(СсылкаРасчета);
	Если ДокументОбъект.ПометкаУдаления Тогда
		ВызватьИсключение "Снимите пометку удаления перед изменением расчёта.";
	КонецЕсли;
	ЗаписатьСумму(ДокументОбъект, Объем, Тариф);
КонецПроцедуры

Процедура ПометитьНаУдаление(СсылкаРасчета) Экспорт
	ДокументОбъект = Получить(СсылкаРасчета);
	Если Не ДокументОбъект.ПометкаУдаления Тогда
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьСумму(ДокументОбъект, Объем, Тариф)
	Если Объем < 0 Или Тариф <= 0 Тогда
		ВызватьИсключение "Объём должен быть неотрицательным, тариф — положительным.";
	КонецЕсли;
	ДокументОбъект.Объем = Объем;
	ДокументОбъект.Тариф = Тариф;
	Если ДокументОбъект.Тариф = 0 Тогда
		ВызватьИсключение "Тариф слишком мал для заданной точности.";
	КонецЕсли;
	ДокументОбъект.Сумма = Окр(ДокументОбъект.Объем * ДокументОбъект.Тариф, 2);
	ДокументОбъект.Записать();
КонецПроцедуры
